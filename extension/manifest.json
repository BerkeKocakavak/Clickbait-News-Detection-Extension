{
  "manifest_version": 3,
  "name": "Clickbait Detector AI",
  "version": "1.0",
  "description": "Real-time AI analysis to detect clickbait headlines on news websites.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ],
      "run_at": "document_idle"
    }
  ]
}